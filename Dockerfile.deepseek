FROM degradation-aware-routing-ocr:ccocr
COPY requirements.deepseek.lock /tmp/requirements.deepseek.lock
RUN PIP_CONSTRAINT= python -m pip install --target /opt/deepseek --no-cache-dir \
    --no-deps --require-hashes --only-binary=:all: -r /tmp/requirements.deepseek.lock
ENV PYTHONPATH=/opt/deepseek:/opt/ccocr
